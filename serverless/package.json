{
  "name": "lumina-serverless",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless backend for the Lumina voice agent (Retell custom functions).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npx vercel dev",
    "dev:local": "tsx --env-file-if-exists=.env scripts/dev-server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:security": "vitest run tests/security.test.ts tests/signature.test.ts",
    "test:watch": "vitest",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "deploy": "npx vercel deploy --prod"
  },
  "dependencies": {
    "retell-client-js-sdk": "^3.0.4",
    "retell-sdk": "^6.2.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
