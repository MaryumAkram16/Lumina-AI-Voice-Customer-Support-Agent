# Lumina voice-agent configuration
# Copy this file to .env locally. Never commit real credentials.

# Full n8n production webhook URL used by Retell tools.
LUMINA_N8N_WEBHOOK_URL=https://your-n8n-host.example.com/webhook/retell

# Retell configuration (used when creating or updating the agent).
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_ACCESS_TOKEN=

# Model-provider credentials used by the n8n workflow.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Sheets destination used for order lookup and post-call records.
GOOGLE_SHEETS_DOCUMENT_ID=
GOOGLE_SHEETS_SHEET_NAME=Orders
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Optional n8n hardening for self-hosted deployments.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Serverless backend (serverless/). Set these in the Vercel dashboard, or in
# serverless/.env for local runs. See serverless/README.md.
# ---------------------------------------------------------------------------

# REQUIRED. RETELL_API_KEY (above) is also what verifies the X-Retell-Signature
# header on every request. Use the Retell API key that has the webhook badge.

# Browser demo page. RETELL_AGENT_ID (above) is the agent the page's
# "Start call" button rings. Leave it empty to switch browser calls off.
# Limits on starting calls, because every call costs Retell minutes:
WEB_CALL_RATE_LIMIT_WINDOW_MS=600000
WEB_CALL_MAX_PER_IP=5
WEB_CALL_MAX_GLOBAL=40
# Optional demo code. When set, the page asks for it before starting a call.
# Share the page as https://your-app.vercel.app/?code=YOUR-CODE to fill it in.
WEB_CALL_PASSCODE=

# Where orders come from: "demo" (synthetic orders, the default), "sheets" or "supabase".
DATA_SOURCE=demo

# Required only when DATA_SOURCE=supabase. Create the table with serverless/supabase/schema.sql.
# Project URL and the SERVER-SIDE key (service_role or sb_secret_...). Never the anon/publishable key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=orders
SUPABASE_TIMEOUT_MS=2000
SUPABASE_MAX_RETRIES=1

# Required only when DATA_SOURCE=sheets.
# The full service-account key file, as one line of JSON or base64-encoded.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Spreadsheet ID from the sheet URL, and the tab that holds the orders.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Orders

# Browser origins allowed to call the API, comma-separated, exact matches only.
# Leave empty: Retell calls server-to-server and needs no CORS.
ALLOWED_ORIGINS=

# Rate limiting (per warm instance).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=120
RATE_LIMIT_MAX_PER_CALL=20

# Largest request body accepted, in bytes.
MAX_BODY_BYTES=102400

# Google Sheets latency controls.
SHEETS_TIMEOUT_MS=1500
SHEETS_MAX_RETRIES=1
SHEETS_BACKOFF_MS=100
SHEETS_CACHE_TTL_MS=15000

# Time zone that decides what "today" is for cancellation and return windows.
BUSINESS_TIMEZONE=UTC
# Word spoken after refund amounts.
CURRENCY_LABEL=PKR
